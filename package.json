{
  "name": "shopademia-storefront",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "test:api": "node --test server/*.test.js",
    "test:e2e": "playwright test tests/e2e/storefront.spec.js --project=chromium",
    "test:e2e:all": "playwright test",
    "validate:staging": "node scripts/validate-staging-config.js",
    "validate:production": "node scripts/validate-production-config.js",
    "staging:compose": "bash scripts/staging-compose.sh",
    "package:deployment": "node scripts/deployment-package.js build",
    "preflight:staging": "node scripts/staging-preflight.js",
    "build:css": "tailwindcss -i css/tailwind.input.css -o css/tailwind.generated.css --minify"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/cli": "^4.3.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
