# Value-free cPanel/Passenger runtime template.
# Populate only through an authorized protected environment-variable mechanism.
# The hosting provider must confirm the PostgreSQL endpoint, TLS mode, proxy hop
# count, assigned PORT, and persistent uploads path before configuring these settings.
NODE_ENV=production
# Use only owner-approved staging origins until staging is authorized.
PUBLIC_SITE_URL=
ADMIN_SITE_URL=
UPLOADS_DIR=
DATABASE_URL=
DATABASE_SSL=
JWT_SECRET=
MFA_ENCRYPTION_KEY=
TRUST_PROXY_HOPS=
DELIVERY_ADVANCE_CHARGE=
ADMIN_SETTINGS_ENCRYPTION_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
